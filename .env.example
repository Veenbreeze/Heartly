# ---------------------------------------------------------------------------
# Heartly environment configuration
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# ---------------------------------------------------------------------------

# Public canonical URL used for share links, auth redirects, and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public support address shown on the contact and help pages.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@heartly.example

# Supabase project connection (Project Settings -> API).
# Hosted: https://<ref>.supabase.co   |   Local: http://127.0.0.1:54321
# Prefer the new publishable key format when your project provides one.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS. NEVER expose this to the browser.
# Hosted projects use the secret key (sb_secret_...) or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private signing secret for password-protected gift unlock cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GIFT_UNLOCK_SECRET=

# Payments: "mock" for local development, "clickpesa" for production.
PAYMENT_PROVIDER=mock

# Mock provider only. Used to sign simulated webhook payloads.
PAYMENT_WEBHOOK_SECRET=local-mock-webhook-secret-change-me

# Simulated payments are always blocked in production unless this is "true".
# Leave unset in production and use ClickPesa instead.
ALLOW_MOCK_PAYMENTS=

# ClickPesa (Tanzania). Create an application under Settings -> Developers.
# The checksum key signs both API payloads and webhook callbacks.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=
CLICKPESA_API_BASE_URL=https://api.clickpesa.com/third-parties

# Transactional email (Resend-compatible HTTP API). Optional in development.
# If unset, the application records the notification but never reports delivery.
RESEND_API_KEY=
EMAIL_FROM=Heartly <hello@heartly.example>
